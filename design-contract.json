  "state_machines": [
    {
      "id": "SM-SEASON",
      "initial_state": "SEASON_START",
      "states": [
        {
          "id": "SEASON_START",
          "entry": "季初：显示本季信息、国运、行情与商路风险预告，玩家决策投保与目的地",
          "exit": "玩家确认出发"
        },
        {
          "id": "TRAVEL_RESOLVE",
          "entry": "按风险概率结算劫掠与货物损失",
          "exit": "到达"
        },
        {
          "id": "MARKET",
          "entry": "在到达城市买卖货物、钱庄借款还款、粮行签合约",
          "exit": "结束本季"
        },
        {
          "id": "SEASON_END",
          "entry": "季末事件结算与贷款计息",
          "exit": "下一季或终局"
        }
      ],
      "event_order": [
        "travel",
        "robbery",
        "arrive",
        "trade",
        "loan_interest",
        "event",
        "next_season"
      ],
      "transitions": [
        {
          "id": "TR-TRAVEL",
          "from": "SEASON_START",
          "event": "玩家选择目的地并确认投保",
          "to": "TRAVEL_RESOLVE",
          "effect": "扣除旅费与保费，记录行程",
          "repeat_policy": "每季仅一次行程",
          "cleanup": "关闭商路面板并锁定本季出行"
        },
        {
          "id": "TR-ROB",
          "from": "TRAVEL_RESOLVE",
          "event": "随机数命中劫掠概率",
          "to": "TRAVEL_RESOLVE",
          "effect": "按投保状态扣货；投保按80%赔付，未投保损失70%",
          "repeat_policy": "一次行程一次结算",
          "cleanup": "记录劫掠事件与损失金额"
        },
        {
          "id": "TR-ARRIVE",
          "from": "TRAVEL_RESOLVE",
          "event": "行程结束",
          "to": "MARKET",
          "effect": "更新所在地与行情",
          "repeat_policy": "唯一一次到达结算",
          "cleanup": "记录到达城市日志"
        },
        {
          "id": "TR-SEASONEND",
          "from": "MARKET",
          "event": "玩家点击'结束本季'",
          "to": "SEASON_END",
          "effect": "触发季末事件、贷款计息、期货结算",
          "repeat_policy": "已结束的季节不可重入",
          "cleanup": "写入季度日志并关闭市场面板"
        },
        {
          "id": "TR-NEXT",
          "from": "SEASON_END",
          "event": "未到第8季且未破产",
          "to": "SEASON_START",
          "effect": "季+1，刷新行情与事件",
          "repeat_policy": "每季一次",
          "cleanup": "清空本季临时状态"
        }
      ]
    },
    {
      "id": "SM-LOAN",
      "initial_state": "NO_DEBT",
      "states": [
        {
          "id": "NO_DEBT",
          "entry": "无贷款",
          "exit": "借款"
        },
        {
          "id": "IN_DEBT",
          "entry": "欠款存在，季末计息15%",
          "exit": "还款或违约"
        },
        {
          "id": "DEFAULT",
          "entry": "资不抵债触发破产终局",
          "exit": "终局"
        }
      ],
      "event_order": [
        "borrow",
        "interest",
        "repay",
        "default"
      ],
      "transitions": [
        {
          "id": "TR-BORROW",
          "from": "NO_DEBT",
          "event": "玩家在钱庄借款",
          "to": "IN_DEBT",
          "effect": "银两增加，负债增加，负债上限=min(银两×2,3000)",
          "repeat_policy": "可多次借入直到上限",
          "cleanup": "记录杠杆峰值与借款次数"
        },
        {
          "id": "TR-INTEREST",
          "from": "IN_DEBT",
          "event": "季末计息",
          "to": "IN_DEBT",
          "effect": "负债×(1+15%)",
          "repeat_policy": "每季一次",
          "cleanup": "记录累计利息"
        },
        {
          "id": "TR-REPAY",
          "from": "IN_DEBT",
          "event": "玩家还款至零",
          "to": "NO_DEBT",
          "effect": "银两减少，负债清零",
          "repeat_policy": "可部分还款，清零才转移",
          "cleanup": "记录还款金额"
        },
        {
          "id": "TR-DEFAULT",
          "from": "IN_DEBT",
          "event": "结算后负债>身家且无货可抵",
          "to": "DEFAULT",
          "effect": "破产终局",
          "repeat_policy": "唯一一次",
          "cleanup": "写入破产结局并锁定操作"
        }
      ]
    },
    {
