  "numeric_requirements": [
    {
      "id": "NUMREQ-BALANCE",
      "statement": "不同策略在8季后的达成率应呈现'稳健≥70%、赌徒≤15%、随机居中'的区分度，证明风险机制可学习且有代价",
      "source": "design_goal",
      "assertion_ids": [
        "ASSERT-STEADY",
        "ASSERT-GAMBLER",
        "ASSERT-RANDOM",
        "ASSERT-GAMBLER-BANKRUPT"
      ]
    },
    {
      "id": "NUMREQ-INSURANCE",
      "statement": "在高风险路线（35%）上投保的期望身家应高于不投保，且方差更低，证明保险机制是理性选择而非摆设",
      "source": "design_goal",
      "assertion_ids": [
        "ASSERT-INS-HIGH"
      ]
    },
    {
      "id": "NUMREQ-FUTURES",
      "statement": "签署青苗合约（对冲）应降低身家波动，同时放弃部分上行，证明期货的'确定性换暴利'本质",
      "source": "design_goal",
      "assertion_ids": [
        "ASSERT-FUTURE-VAR"
      ]
    }
  ],
