          "entry": "北方资产×0.6折算，南方保值",
          "exit": "评级"
        },
        {
          "id": "REPORT",
          "entry": "生成体检报告与知识清单",
          "exit": "重开"
        }
      ],
      "event_order": [
        "season8_end",
        "discount",
        "rate",
        "report",
        "restart"
      ],
      "transitions": [
        {
          "id": "TR-SETTLE",
          "from": "RUNNING",
          "event": "第8季季末",
