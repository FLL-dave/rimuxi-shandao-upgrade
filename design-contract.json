{
  "schema_version": "6.0",
  "task": {
    "title": "日暮西山·商道 GDD与Demo",
    "source_text": "把《韭菜大冒险》承载的耶鲁希勒《金融市场》知识理念与骑砍1《日暮西山》mod（1643年明末乱世、多势力、国运倾覆）相融合，达到学习知识的目的，用相关skill设计生成；建模相关内容与git相结合。",
    "readiness_target": "prototype",
    "flags": {
      "capacity": false,
      "handoff": false,
      "html": true,
      "lifecycle": true,
      "numbers": true,
      "persistence": false,
      "probability": true,
      "production": false,
      "resources": true,
      "scope_constraints": false
    }
  },
  "authority": {
    "allowed_changes": [],
    "forbidden_changes": [],
    "proposed_changes": []
  },
  "assumptions": [
    {
      "id": "ASM-IP",
      "statement": "《日暮西山》为社区mod，本设计为学习向同人概念设计，不复制其资产与文案，仅借用其时代设定与国运倾覆主题",
      "impact": "low",
      "status": "confirmed",
      "validation": "由设计素材决定"
    },
    {
      "id": "ASM-LEARNING",
      "statement": "学习目的通过'机制即知识'达成：每个核心机制首次触发弹出智慧卡（公式+希勒引语+大明映射），局后体检报告按决策行为点评知识点",
      "impact": "high",
      "status": "test_value",
      "validation": "由Demo试玩与知识层完整性检查确认"
    },
    {
      "id": "ASM-DELIVERY",
      "statement": "沿用上一任务确立的交付模式：单文件可玩HTML Demo + 飞书GDD，Demo内嵌配置为唯一配置源，Python脚本提取同一配置做数值模拟，建模内容入git仓库托管",
      "impact": "low",
      "status": "confirmed",
      "validation": "由交付物核对"
    }
  ],
  "rules": [
    {
      "id": "RULE-TRAVEL",
      "title": "行商循环",
      "definition": "每季一回合：读取本城行情与商路风险预告→决策投保→选择目的地出发→结算劫掠→到城后买卖→季末事件与结算→下一季。",
      "priority": "P0",
      "parameter_ids": [
        "PAR-START-SILVER",
        "PAR-SEASONS",
        "PAR-CARGO-CAP"
      ],
      "state_machine_ids": [
        "SM-SEASON"
      ],
      "authority_ids": [],
      "fields": []
    },
    {
      "id": "RULE-INSURANCE",
      "title": "镖局保险",
      "definition": "出发前可选投保：保费=货物市值×6%，被劫时赔付80%损失；未投保被劫损失70%货物。保费是把'小概率大损失'变成'确定的小损失'。",
      "priority": "P0",
      "parameter_ids": [
        "PAR-INS-PREMIUM",
        "PAR-INS-COVERAGE",
        "PAR-INS-LOSS-UNINSURED"
      ],
      "state_machine_ids": [],
      "authority_ids": [],
      "fields": []
    },
    {
      "id": "RULE-LOAN",
      "title": "钱庄杠杆",
      "definition": "借款上限=min(当前银两×2,3000两)，季利率15%复利；季末未还清则强制抛货抵债（按0.8市价），仍资不抵债即破产终局。",
      "priority": "P0",
      "parameter_ids": [
        "PAR-LOAN-RATE",
        "PAR-LOAN-MAX-MULT",
        "PAR-LOAN-CAP"
      ],
      "state_machine_ids": [
        "SM-LOAN"
      ],
      "authority_ids": [],
      "fields": []
    },
    {
      "id": "RULE-FUTURES",
      "title": "粮行青苗合约",
      "definition": "汉口粮行每季可签远期合约：以锁定价P承诺下季买入Q石（0≤Q≤100，最多2份）。下季按市价结算差价：市价>P盈利，市价<P亏损（先扣银两，不足强制抛货，再不足破产）。",
      "priority": "P0",
      "parameter_ids": [
        "PAR-FUTURE-Q-MAX",
        "PAR-FUTURE-CAP"
      ],
      "state_machine_ids": [
        "SM-FUTURES"
      ],
      "authority_ids": [],
      "fields": []
    },
    {
      "id": "RULE-ENDING",
      "title": "终局结算与知识体检",
      "definition": "第8季（1644秋）终局：北方城市资产按0.6折算（战火），南方保值；结算身家→评级；按本局决策（投保次数/商路多样性/杠杆峰值/合约数/炒地参与/现金比例）生成希勒式点评与已掌握概念清单。",
      "priority": "P0",
      "parameter_ids": [
        "PAR-TARGET-SURVIVE",
        "PAR-TARGET-BIG",
        "PAR-TARGET-KING",
        "PAR-NORTH-DISCOUNT"
      ],
      "state_machine_ids": [
        "SM-ENDING"
      ],
      "authority_ids": [],
      "fields": []
    }
  ],
